---
const items = [
    {
        href: "/empleados",
        label: "Empleados",
        svg: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/><path d="M4 20a8 8 0 0 1 16 0"/></svg>`,
    },
    {
        href: "/servicios",
        label: "Porcentajes",
        svg: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v18"/><path d="M7 8h7a3 3 0 0 1 0 6H9a3 3 0 0 0 0 6h8"/></svg>`,
    },
    {
        href: "/ventas",
        label: "Ventas",
        svg: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M12 9v6"/><path d="M9 12h6"/></svg>`,
    },
    {
        href: "/vales",
        label: "Vales",
        svg: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M8 14h3"/></svg>`,
    },
    {
        href: "/caja",
        label: "Caja",
        svg: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M3 11h18"/><circle cx="12" cy="15" r="1.5"/></svg>`,
    },
    {
        href: "/reportes",
        label: "Facturas",
        svg: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h4"/></svg>`,
    },
    {
        href: "/reservas",
        label: "Agenda",
        svg: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4"/><path d="M16 3v4"/><path d="M4 10h16"/></svg>`,
    },
    {
        href: "/agenda-laser",
        label: "Láser",
        svg: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v4"/><path d="m8 5 4 8 4-8"/><path d="M7 21h10"/><path d="M9 13h6v3a3 3 0 0 1-6 0v-3Z"/></svg>`,
    },
    {
        href: "/deudores",
        label: "Deudores",
        svg: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 7.5v1"/><path d="M12 15.5v1"/><path d="M10 10.2c.4-.9 1.2-1.4 2.2-1.4 1.2 0 2 .7 2 1.7 0 2.2-4 1.3-4 3.6 0 1 .8 1.7 2 1.7 1 0 1.7-.4 2.1-1.1"/></svg>`,
    },
    {
        href: "/tasas",
        label: "Tasas",
        svg: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 17 9 7l4 7 2.5-5L20 17"/><path d="M3 17h18"/></svg>`,
    },
    {
        href: "/paquetesMariana",
        label: "Paquetes",
        svg: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8.5 12 4l8 4.5v7L12 20l-8-4.5v-7Z"/><path d="M12 12v8"/><path d="M4 8.5 12 12l8-3.5"/></svg>`,
    },
];
---

<nav class="sp-nav" aria-label="Menú principal">
    <div class="sp-nav-inner">
        <a href="/ventas" class="sp-nav-logo" aria-label="Spabella">
            <img src="/logo.png" alt="Spabella" width="48" height="48" />
        </a>

        <ul class="sp-nav-list">
            {items.map((item) => (
                <li>
                    <a href={item.href} class="sp-nav-link" data-path={item.href}>
                        <span class="sp-nav-icon" set:html={item.svg} />
                        <span class="sp-nav-text">{item.label}</span>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</nav>

<script>
    const path = window.location.pathname;
    document.querySelectorAll(".sp-nav-link").forEach((link) => {
        const href = link.getAttribute("data-path") || "";
        const active = path === href || path.startsWith(`${href}/`);
        if (active) link.classList.add("is-active");
    });
</script>

<style>
    .sp-nav {
        margin: 0 8% 1.5rem;
        padding: 0.85rem 1rem;
        background: rgba(255, 253, 249, 0.88);
        border: 1px solid rgba(230, 215, 192, 0.95);
        border-radius: 18px;
        box-shadow:
            0 10px 28px rgba(77, 77, 77, 0.08),
            inset 0 1px 0 rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(10px);
    }

    .sp-nav-inner {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1.1rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .sp-nav-logo {
        flex-shrink: 0;
        display: grid;
        place-items: center;
        width: 54px;
        height: 54px;
        border-radius: 14px;
        background: linear-gradient(160deg, #fff 0%, #f7efe3 100%);
        border: 1px solid #eadfce;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .sp-nav-logo:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(221, 181, 127, 0.28);
    }

    .sp-nav-logo img {
        width: 40px;
        height: 40px;
        object-fit: contain;
        display: block;
    }

    .sp-nav-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        flex: 0 1 auto;
        min-width: 0;
    }

    .sp-nav-link {
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        width: 74px;
        padding: 0.45rem 0.25rem;
        border-radius: 14px;
        color: #4d4d4d;
        transition:
            background 0.2s ease,
            color 0.2s ease,
            transform 0.2s ease;
    }

    .sp-nav-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: #f4eee4;
        border: 1px solid #eadfce;
        color: #5a5348;
        transition:
            background 0.2s ease,
            border-color 0.2s ease,
            color 0.2s ease,
            box-shadow 0.2s ease,
            transform 0.2s ease;
    }

    .sp-nav-icon :global(svg) {
        width: 22px;
        height: 22px;
        display: block;
        stroke: currentColor;
        stroke-width: 1.75;
        stroke-linecap: round;
        stroke-linejoin: round;
        fill: none;
    }

    .sp-nav-text {
        font-size: 0.68rem;
        line-height: 1.15;
        font-weight: 700;
        letter-spacing: 0.01em;
        text-align: center;
        color: inherit;
    }

    .sp-nav-link:hover {
        background: rgba(221, 181, 127, 0.14);
        transform: translateY(-1px);
    }

    .sp-nav-link:hover .sp-nav-icon {
        background: #fff8ee;
        border-color: #ddb57f;
        color: #a0783a;
        box-shadow: 0 4px 12px rgba(221, 181, 127, 0.25);
    }

    .sp-nav-link.is-active {
        background: rgba(221, 181, 127, 0.2);
    }

    .sp-nav-link.is-active .sp-nav-icon {
        background: linear-gradient(160deg, #e8c797 0%, #ddb57f 100%);
        border-color: #c9a066;
        color: #4d4d4d;
        box-shadow: 0 4px 14px rgba(221, 181, 127, 0.35);
    }

    .sp-nav-link.is-active .sp-nav-text {
        color: #8a6428;
    }

    @media (max-width: 900px) {
        .sp-nav {
            margin: 0 4% 1rem;
            padding: 0.7rem 0.75rem;
        }

        .sp-nav-inner {
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
        }

        .sp-nav-logo {
            align-self: center;
        }

        .sp-nav-list {
            justify-content: center;
            width: 100%;
        }

        .sp-nav-link {
            width: 68px;
        }
    }

    @media (max-width: 560px) {
        .sp-nav {
            margin: 0 0 0.85rem;
            border-radius: 0;
            border-left: none;
            border-right: none;
        }

        .sp-nav-link {
            width: 62px;
            padding: 0.35rem 0.15rem;
        }

        .sp-nav-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
        }

        .sp-nav-icon :global(svg) {
            width: 20px;
            height: 20px;
        }

        .sp-nav-text {
            font-size: 0.62rem;
        }
    }
</style>
