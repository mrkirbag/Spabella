---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <main class="container-general page-facturacion">
        <h1>FACTURACIÓN</h1>

        <div class="modulo-busqueda">
            <div class="campo-busqueda">
                <label for="fechaDesde">Desde</label>
                <input type="date" id="fechaDesde" />
            </div>
            <div class="campo-busqueda">
                <label for="fechaHasta">Hasta</label>
                <input type="date" id="fechaHasta" />
            </div>
            <button id="buscarFacturacion" type="button">Generar Facturación</button>
        </div>

        <div id="facturaImprimir" class="facturacion-wrap">
            <h2 id="tituloFacturacion" class="oculto titulo-reporte">Reporte de Facturación</h2>
            <div id="listaFacturacion"></div>
            <section id="cajaFinal" class="sp-panel caja-final" hidden></section>
        </div>

        <div class="boton-impresion">
            <button id="imprimirFacturacion" class="oculto" type="button">Imprimir Facturación</button>
        </div>
    </main>

    <script type="module">
        const fmt = (n) => Number(n || 0).toFixed(2);

        const colorMoneda = (moneda) => {
            if (moneda === "USD") return "sp-money-usd";
            if (moneda === "COP") return "sp-money-cop";
            return "sp-money-bs";
        };

        const renderPagos = (pagos = []) => {
            if (!pagos.length) return `<span class="rf-dash">—</span>`;
            return `
                <div class="sp-money">
                    ${pagos.map((pago) => `
                        <div class="sp-money-item ${colorMoneda(pago.moneda)}">
                            <strong>${fmt(pago.monto)}</strong>
                            <span>${pago.moneda}</span>
                        </div>
                        <span class="sp-money-meta">${pago.metodo || "Sin método"}</span>
                    `).join("")}
                </div>
            `;
        };

        const renderPartes = (data) => {
            const items = [];
            if (Number(data?.usd) > 0) {
                items.push(`
                    <div class="sp-money-item sp-money-usd">
                        <strong>${fmt(data.usd)}</strong>
                        <span>USD</span>
                    </div>
                `);
            }
            if (Number(data?.cop) > 0) {
                items.push(`
                    <div class="sp-money-item sp-money-cop">
                        <strong>${fmt(data.cop)}</strong>
                        <span>COP</span>
                    </div>
                `);
            }
            if (Number(data?.bs) > 0) {
                items.push(`
                    <div class="sp-money-item sp-money-bs">
                        <strong>${fmt(data.bs)}</strong>
                        <span>BS</span>
                    </div>
                `);
            }
            return items.length
                ? `<div class="sp-money">${items.join("")}</div>`
                : `<span class="rf-dash">—</span>`;
        };

        const bloqueTotales = (titulo, data, tipo = "producido", nota = "") => `
            <div class="rf-bloque rf-bloque-${tipo}">
                <div class="rf-bloque-head">
                    <div class="rf-bloque-head-text">
                        <span class="rf-bloque-label">${
                            tipo === "empleada" ? "Comisión"
                            : tipo === "spa" ? "Retención"
                            : tipo === "vale" ? "Anticipo"
                            : tipo === "apagar" ? "Liquidación"
                            : "Ingreso"
                        }</span>
                        <h3>${titulo}</h3>
                        ${nota ? `<p class="rf-bloque-nota">${nota}</p>` : ""}
                    </div>
                    <span class="rf-bloque-mark" aria-hidden="true"></span>
                </div>
                <div class="sp-totales rf-totales">
                    <div class="sp-total sp-total-usd">
                        <span>USD</span>
                        <strong>${fmt(data?.usd)}</strong>
                    </div>
                    <div class="sp-total sp-total-cop">
                        <span>COP</span>
                        <strong>${fmt(data?.cop)}</strong>
                    </div>
                    <div class="sp-total sp-total-bs">
                        <span>BS</span>
                        <strong>${fmt(data?.bs)}</strong>
                    </div>
                </div>
            </div>
        `;

        document.getElementById("buscarFacturacion").addEventListener("click", async () => {
            const desde = document.getElementById("fechaDesde").value;
            const hasta = document.getElementById("fechaHasta").value;
            const lista = document.getElementById("listaFacturacion");
            const cajaFinal = document.getElementById("cajaFinal");
            const btnPrint = document.getElementById("imprimirFacturacion");
            const titulo = document.getElementById("tituloFacturacion");

            if (!desde || !hasta) {
                alert("Selecciona el rango de fechas.");
                return;
            }

            const response = await fetch(`/api/reportes-ventas?desde=${desde}&hasta=${hasta}`);
            const data = await response.json();

            lista.innerHTML = "";
            cajaFinal.hidden = true;
            cajaFinal.innerHTML = "";

            if (data.mensaje) {
                lista.innerHTML = `<p class="sp-msg-empty sp-panel" style="padding:1.1rem;">${data.mensaje}</p>`;
                btnPrint.classList.add("oculto");
                btnPrint.classList.remove("visible");
                titulo.classList.add("oculto");
                titulo.classList.remove("visible");
                return;
            }

            const empleadas = data.empleadas || [];
            const generales = data.totalesGenerales || {};
            const tasas = data.tasas || {};

            empleadas.forEach((emp, index) => {
                const panel = document.createElement("section");
                panel.className = "sp-panel rf-panel";

                const filas = (emp.servicios || []).map((s) => {
                    const fecha = new Date(s.fecha + "T00:00:00").toLocaleDateString("es-ES", {
                        day: "2-digit",
                        month: "2-digit",
                        year: "numeric",
                    });
                    return `
                        <tr>
                            <td class="rf-fecha">${fecha}</td>
                            <td class="sp-desc">
                                <strong>${s.descripcion}</strong>
                                <small>SPA ${fmt(s.porcentajeSpa)}% · Emp. ${fmt(s.porcentajeEmpleado)}%</small>
                            </td>
                            <td class="sp-num sp-usd">${fmt(s.montoTotalUsd)}</td>
                            <td>${renderPagos(s.pagos)}</td>
                            <td>${renderPartes(s.empleado)}</td>
                            <td>${renderPartes(s.spa)}</td>
                        </tr>
                    `;
                }).join("");

                panel.innerHTML = `
                    <div class="sp-panel-header">
                        <div>
                            <p class="sp-eyebrow">Empleada ${index + 1}</p>
                            <h2>${emp.nombre}</h2>
                        </div>
                        <span class="sp-chip">${(emp.servicios || []).length} venta${(emp.servicios || []).length === 1 ? "" : "s"}${(emp.vales || []).length ? ` · ${emp.vales.length} vale${emp.vales.length === 1 ? "" : "s"}` : ""}</span>
                    </div>

                    ${bloqueTotales("Producido", emp.totales?.producido, "producido", "Total cobrado en el período")}
                    ${bloqueTotales("Para la empleada", emp.totales?.empleado, "empleada", "Parte correspondiente según %")}
                    ${bloqueTotales("Vales descontados", emp.totales?.vales, "vale", "Anticipos entregados en el período")}
                    ${bloqueTotales("A pagar", emp.totales?.aPagar, "apagar", "Comisión menos vales")}
                    ${bloqueTotales("Para el SPA", emp.totales?.spa, "spa", "Parte retenida por Spabella")}

                    ${
                        (emp.vales || []).length
                            ? `
                        <div class="sp-panel-body">
                            <h3 class="sp-subtitle">Vales de la empleada</h3>
                            <table class="sp-table">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Monto</th>
                                        <th>Método</th>
                                        <th>Nota</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${emp.vales.map((v) => `
                                        <tr>
                                            <td>${v.fecha}</td>
                                            <td class="sp-num">${fmt(v.monto)} ${v.moneda}</td>
                                            <td>${v.metodo || "—"}</td>
                                            <td>${v.nota || "—"}</td>
                                        </tr>
                                    `).join("")}
                                </tbody>
                            </table>
                        </div>
                    `
                            : ""
                    }

                    <div class="sp-panel-body">
                        <h3 class="sp-subtitle">Detalle de servicios</h3>
                        <table class="sp-table">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Servicio</th>
                                    <th>Total USD</th>
                                    <th>Pagos</th>
                                    <th>Empleada</th>
                                    <th>SPA</th>
                                </tr>
                            </thead>
                            <tbody>${filas || `<tr><td colspan="6" class="sp-empty">Sin servicios en el período.</td></tr>`}</tbody>
                        </table>
                    </div>
                `;

                lista.appendChild(panel);
            });

            const metodosRows = (generales.porMetodo || []).map((m) => `
                <tr>
                    <td><strong>${m.metodo}</strong></td>
                    <td class="sp-num sp-usd">${m.usd > 0 ? fmt(m.usd) : "—"}</td>
                    <td class="sp-num sp-cop">${m.cop > 0 ? fmt(m.cop) : "—"}</td>
                    <td class="sp-num sp-bs">${m.bs > 0 ? fmt(m.bs) : "—"}</td>
                </tr>
            `).join("");

            cajaFinal.hidden = false;
            cajaFinal.innerHTML = `
                <div class="sp-panel-header rf-header-caja">
                    <div>
                        <p class="sp-eyebrow">Cierre de caja</p>
                        <h2>Totales generales del período</h2>
                    </div>
                    <span class="sp-chip">BS ${tasas.bs > 0 ? fmt(tasas.bs) : "N/D"} · COP ${tasas.cop > 0 ? fmt(tasas.cop) : "N/D"}</span>
                </div>

                <div class="sp-totales">
                    <div class="sp-total sp-total-usd">
                        <span>Caja USD</span>
                        <strong>${fmt(generales.caja?.usd)}</strong>
                    </div>
                    <div class="sp-total sp-total-cop">
                        <span>Caja COP</span>
                        <strong>${fmt(generales.caja?.cop)}</strong>
                    </div>
                    <div class="sp-total sp-total-bs">
                        <span>Caja BS</span>
                        <strong>${fmt(generales.caja?.bs)}</strong>
                    </div>
                </div>

                ${bloqueTotales("Total empleadas", generales.empleado, "empleada", "Suma de comisiones del período")}
                ${bloqueTotales("Total vales", generales.vales, "vale", "Anticipos del período")}
                ${bloqueTotales("Total a pagar", generales.aPagar, "apagar", "Comisiones menos vales")}
                ${bloqueTotales("Total SPA", generales.spa, "spa", "Suma retenida por Spabella")}

                <div class="sp-panel-body">
                    <p class="rf-meta">${empleadas.length} empleada${empleadas.length === 1 ? "" : "s"} · ${data.totalVentas || 0} ventas · ${data.totalVales || 0} vales</p>
                    <h3 class="sp-subtitle">Caja por método de pago</h3>
                    <table class="sp-table">
                        <thead>
                            <tr>
                                <th>Método</th>
                                <th>USD</th>
                                <th>COP</th>
                                <th>BS</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${metodosRows || `<tr><td colspan="4" class="sp-empty">Sin pagos registrados.</td></tr>`}
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>Total</td>
                                <td class="sp-num sp-usd">${fmt(generales.caja?.usd)}</td>
                                <td class="sp-num sp-cop">${fmt(generales.caja?.cop)}</td>
                                <td class="sp-num sp-bs">${fmt(generales.caja?.bs)}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            `;

            btnPrint.classList.add("visible");
            btnPrint.classList.remove("oculto");
            titulo.classList.add("visible");
            titulo.classList.remove("oculto");
        });

        document.getElementById("imprimirFacturacion").addEventListener("click", () => {
            const contenido = document.getElementById("facturaImprimir").innerHTML;
            const ventana = window.open("", "", "width=980,height=720");
            ventana.document.write(`
                <html>
                <head>
                    <title>Facturación</title>
                    <style>
                        body{font-family:Arial,sans-serif;margin:16px;color:#222}
                        h2,h3{margin:0 0 6px;text-align:left}
                        .sp-panel{border:1px solid #999;margin-bottom:14px;padding:10px;page-break-inside:avoid}
                        .sp-totales{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin:8px 0}
                        .sp-total{border:1px solid #ccc;padding:8px}
                        table{width:100%;border-collapse:collapse;margin-top:8px}
                        th,td{border:1px solid #000;padding:6px;font-size:11px;vertical-align:top;text-align:left}
                        thead th{background:#ddd}
                        .sp-money-item{margin-bottom:2px}
                        small{display:block;color:#555}
                    </style>
                </head>
                <body>${contenido}</body>
                </html>
            `);
            ventana.document.close();
            ventana.focus();
            ventana.print();
        });
    </script>

    <style is:global>
        /* Aislamiento: los globales de Style.astro no deben romper HTML dinámico */
        .page-facturacion {
            text-align: left;
            overflow-x: clip;
        }

        .page-facturacion .facturacion-wrap {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            text-align: left;
        }

        .page-facturacion .titulo-reporte {
            text-align: center !important;
            margin: 0 0 1rem !important;
            color: #4d4d4d;
            font-size: 1.25rem;
            font-weight: 800;
        }

        .page-facturacion #listaFacturacion {
            display: grid;
            gap: 1.25rem;
            width: 100%;
        }

        .page-facturacion .sp-panel,
        .page-facturacion .rf-panel {
            width: 100%;
            max-width: 1100px;
            margin-left: auto;
            margin-right: auto;
            overflow: visible;
            text-align: left !important;
        }

        .page-facturacion .sp-panel-header {
            text-align: left;
        }

        .page-facturacion .sp-panel-header h2 {
            margin: 0 !important;
            text-align: left !important;
            color: #4d4d4d !important;
            font-size: 1.2rem !important;
            font-weight: 800 !important;
            text-transform: capitalize;
        }

        .page-facturacion .sp-eyebrow {
            text-align: left;
        }

        .page-facturacion .rf-header-caja {
            background: linear-gradient(135deg, #4d4d4d 0%, #6a6a6a 100%);
            border-bottom-color: #3a3a3a;
        }

        .page-facturacion .rf-header-caja h2,
        .page-facturacion .rf-header-caja .sp-eyebrow {
            color: #fff !important;
        }

        .page-facturacion .rf-header-caja .sp-eyebrow {
            opacity: 0.75;
        }

        .page-facturacion .rf-header-caja .sp-chip {
            background: rgba(255, 255, 255, 0.18);
            color: #fff;
        }

        .page-facturacion .rf-bloque {
            margin: 0.85rem 1.15rem 0;
            border-radius: 12px;
            border: 1px solid #eadfce;
            overflow: hidden;
            background: #fff;
        }

        .page-facturacion .rf-bloque-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.7rem 0.95rem;
            border-bottom: 1px solid transparent;
        }

        .page-facturacion .rf-bloque-head-text {
            min-width: 0;
            text-align: left;
        }

        .page-facturacion .rf-bloque-label {
            display: inline-block;
            font-size: 0.62rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 800;
            margin-bottom: 0.12rem;
            opacity: 0.85;
        }

        .page-facturacion .rf-bloque-head h3 {
            margin: 0 !important;
            text-align: left !important;
            font-size: 1rem !important;
            font-weight: 800 !important;
            letter-spacing: 0.01em;
            line-height: 1.2;
            color: inherit !important;
        }

        .page-facturacion .rf-bloque-nota {
            margin: 0.2rem 0 0;
            font-size: 0.72rem;
            font-weight: 600;
            opacity: 0.8;
            line-height: 1.3;
        }

        .page-facturacion .rf-bloque-mark {
            flex-shrink: 0;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.35);
        }

        .page-facturacion .rf-bloque-producido .rf-bloque-head {
            background: linear-gradient(135deg, #c48a2e 0%, #ddb57f 100%);
            color: #fffaf0;
            border-bottom-color: #b57a22;
        }

        .page-facturacion .rf-bloque-producido .rf-bloque-mark {
            background: #fff6e8;
        }

        .page-facturacion .rf-bloque-empleada .rf-bloque-head {
            background: linear-gradient(135deg, #1f5f39 0%, #3d8a58 100%);
            color: #f3faf5;
            border-bottom-color: #184a2d;
        }

        .page-facturacion .rf-bloque-empleada .rf-bloque-mark {
            background: #e8f4ec;
        }

        .page-facturacion .rf-bloque-spa .rf-bloque-head {
            background: linear-gradient(135deg, #3f4f8f 0%, #5d6fad 100%);
            color: #f4f6fc;
            border-bottom-color: #334175;
        }

        .page-facturacion .rf-bloque-spa .rf-bloque-mark {
            background: #e9eef8;
        }

        .page-facturacion .rf-bloque-vale .rf-bloque-head {
            background: linear-gradient(135deg, #9b3b3b 0%, #c45c5c 100%);
            color: #fff5f5;
            border-bottom-color: #7e2f2f;
        }

        .page-facturacion .rf-bloque-vale .rf-bloque-mark {
            background: #fdeaea;
        }

        .page-facturacion .rf-bloque-apagar .rf-bloque-head {
            background: linear-gradient(135deg, #2f4a3a 0%, #4d4d4d 100%);
            color: #f5f7f6;
            border-bottom-color: #24382c;
        }

        .page-facturacion .rf-bloque-apagar .rf-bloque-mark {
            background: #e8f4ec;
        }

        .page-facturacion .rf-bloque .rf-totales {
            padding: 0.75rem !important;
            margin: 0;
        }

        .page-facturacion .rf-totales,
        .page-facturacion .sp-totales {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            padding-left: 0;
            padding-right: 0;
        }

        .page-facturacion .sp-total-cop,
        .page-facturacion .sp-money-cop {
            background: #f7f0e4;
            color: #8a5a12;
        }

        .page-facturacion .sp-total-cop {
            border-left: 5px solid #c48a2e;
        }

        .page-facturacion .sp-panel-body {
            padding: 0.85rem 1.15rem 1.2rem;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .page-facturacion .sp-panel-body .sp-subtitle {
            margin: 0 0 0.65rem !important;
            text-align: left !important;
        }

        .page-facturacion .sp-panel table,
        .page-facturacion .sp-panel .sp-table {
            margin: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            border: none !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            table-layout: auto;
        }

        .page-facturacion .sp-panel table thead th,
        .page-facturacion .sp-panel .sp-table thead th {
            background: #4d4d4d !important;
            color: #fff !important;
            text-align: left !important;
        }

        .page-facturacion .sp-panel table td,
        .page-facturacion .sp-panel .sp-table td {
            text-align: left !important;
            vertical-align: top !important;
            word-break: break-word;
        }

        .page-facturacion .sp-panel .sp-num {
            text-align: right !important;
            white-space: nowrap;
        }

        .page-facturacion .rf-fecha {
            white-space: nowrap;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .page-facturacion .sp-cop {
            color: #8a5a12 !important;
        }

        .page-facturacion .rf-dash {
            color: #c0b6a8;
            font-weight: 700;
        }

        .page-facturacion .rf-meta {
            margin: 0 0 0.75rem;
            color: #7a7165;
            font-size: 0.85rem;
            font-weight: 700;
        }

        .page-facturacion .caja-final {
            margin-top: 1.25rem;
        }

        .page-facturacion .sp-desc small {
            display: inline-block;
            margin-top: 0.2rem;
        }

        @media (max-width: 768px) {
            .page-facturacion .rf-totales,
            .page-facturacion .sp-totales {
                grid-template-columns: 1fr;
            }
        }

        @media print {
            .page-facturacion .modulo-busqueda,
            .page-facturacion .boton-impresion,
            .page-facturacion button {
                display: none !important;
            }
        }
    </style>
</Layout>
