---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <main class="container-general">
        <h1>Bienvenida Mariana!</h1>
        <div class="box-texto">
            <p> 
                Aquí podrás ver el historial de los paquetes de tus clientes. <br>
                1. Selecciona un paciente para ver sus paquetes. <br>
                2. Selecciona un paquete de dicho cliente para ver sus detalles. <br>
                3. Puedes agregar sesiones para ese paquete. <br>
                4. Y, por último, puedes agregar un nuevo paquete para cualquier cliente.
            </p>
        </div>

        <div class="box-buscador">
            <label for="buscar-cliente">Buscar paciente</label>
            <input type="text" id="buscar-cliente" placeholder="Buscar paciente" autocomplete="off" />
            <br>
            <label for="cliente">Paciente</label>
            <select name="cliente" id="cliente">
                <option value="">Paciente</option>
            </select>
        </div>

        <ol id="listaPaquetes"></ol>

        <div class="container-boton_agregar botones-acciones">
            <a href="/paquetesMariana/agregar-paquetes" class="boton-agregar">Agregar Paquete</a>
            <a href="/clientes/agregar-clientes" class="boton-agregar">Agregar Nuevo Cliente</a>
            <a href="#" id="btnListaClientes" class="boton-agregar">Lista de clientes</a>
        </div>

        <section id="listaClientesSection" class="lista-clientes-section" hidden>
            <table id="tablaListaClientes" class="sp-table"></table>
            <div id="paginacionClientes" class="paginacion-clientes"></div>
        </section>
    </main>

    <script type="module">

        const buscarClienteInput = document.getElementById("buscar-cliente");
        const clienteSelect = document.getElementById("cliente");
        const btnListaClientes = document.getElementById("btnListaClientes");
        const listaClientesSection = document.getElementById("listaClientesSection");
        const tablaListaClientes = document.getElementById("tablaListaClientes");
        const paginacionClientes = document.getElementById("paginacionClientes");
        let clientesCache = [];
        let listaClientesVisible = false;
        let paginaActualClientes = 1;
        const CLIENTES_POR_PAGINA = 20;

        const construirTelefonoWhatsapp = (celular) => {
            const celularLimpio = String(celular || '').replace(/\D/g, '');
            let numeroWhatsapp = celularLimpio;

            if (numeroWhatsapp.startsWith('0')) {
                numeroWhatsapp = numeroWhatsapp.slice(1);
            }

            if (numeroWhatsapp.length === 9) {
                numeroWhatsapp = `58${numeroWhatsapp}`;
            }

            return { celularLimpio, numeroWhatsapp };
        };

        const renderListaClientes = () => {
            const clientesOrdenados = [...clientesCache].sort((a, b) =>
                String(a.nombre || '').localeCompare(String(b.nombre || ''), 'es', { sensitivity: 'base' })
            );

            const totalPaginas = Math.max(1, Math.ceil(clientesOrdenados.length / CLIENTES_POR_PAGINA));

            if (paginaActualClientes > totalPaginas) {
                paginaActualClientes = totalPaginas;
            }

            const inicio = (paginaActualClientes - 1) * CLIENTES_POR_PAGINA;
            const clientesPagina = clientesOrdenados.slice(inicio, inicio + CLIENTES_POR_PAGINA);

            tablaListaClientes.innerHTML = `
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Teléfono</th>
                    </tr>
                </thead>
                <tbody></tbody>
            `;

            const tbody = tablaListaClientes.querySelector('tbody');

            clientesPagina.forEach((cliente) => {
                const { celularLimpio, numeroWhatsapp } = construirTelefonoWhatsapp(cliente.celular);
                const mensajeWhatsapp = encodeURIComponent(
                    `Hola ${String(cliente.nombre || '').toUpperCase()}, te escribimos de Spabella.`
                );
                const linkWhatsapp = numeroWhatsapp
                    ? `https://wa.me/${numeroWhatsapp}?text=${mensajeWhatsapp}`
                    : '#';

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${String(cliente.nombre || '').toUpperCase()}</td>
                    <td>
                        <a href="${linkWhatsapp}" target="_blank" rel="noopener noreferrer" class="link-whatsapp">
                            <span class="link-whatsapp__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M4 5.5C4 4.67157 4.67157 4 5.5 4H18.5C19.3284 4 20 4.67157 20 5.5V14.5C20 15.3284 19.3284 16 18.5 16H9.5L5.2 19.3C4.53956 19.8063 3.6 19.3353 3.6 18.5V16.5C3.6 16.2239 3.82386 16 4.1 16H5.5C4.67157 16 4 15.3284 4 14.5V5.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                                    <path d="M8 8.5H16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                                    <path d="M8 11.5H13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                                </svg>
                            </span>
                            <span>${celularLimpio ? `0${celularLimpio}` : 'Sin teléfono'}</span>
                        </a>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            paginacionClientes.innerHTML = `
                <button type="button" class="paginacion-btn" id="btnPaginaAnterior" ${paginaActualClientes <= 1 ? 'disabled' : ''}>
                    Anterior
                </button>
                <span class="paginacion-info">Página ${paginaActualClientes} de ${totalPaginas}</span>
                <button type="button" class="paginacion-btn" id="btnPaginaSiguiente" ${paginaActualClientes >= totalPaginas ? 'disabled' : ''}>
                    Siguiente
                </button>
            `;

            document.getElementById('btnPaginaAnterior')?.addEventListener('click', () => {
                if (paginaActualClientes > 1) {
                    paginaActualClientes -= 1;
                    renderListaClientes();
                }
            });

            document.getElementById('btnPaginaSiguiente')?.addEventListener('click', () => {
                if (paginaActualClientes < totalPaginas) {
                    paginaActualClientes += 1;
                    renderListaClientes();
                }
            });
        };

        const renderClientes = (filtro = '') => {
            const termino = filtro.trim().toLowerCase();
            const clientesFiltrados = termino
                ? clientesCache.filter((cliente) => {
                    const textoBusqueda = `${cliente.nombre} ${cliente.celular}`.toLowerCase();
                    return textoBusqueda.includes(termino);
                })
                : clientesCache;

            clienteSelect.innerHTML = '';

            const optionDefault = document.createElement("option");
            optionDefault.value = "";
            optionDefault.textContent = clientesFiltrados.length
                ? 'Paciente'
                : 'Sin resultados';
            clienteSelect.appendChild(optionDefault);

            clientesFiltrados.forEach(cliente => {
                const option = document.createElement("option");
                option.value = cliente.id;
                option.textContent = `${cliente.nombre.toUpperCase()}`;
                clienteSelect.appendChild(option);
            });
        };

        const response = await fetch("/api/clientes/rellenar-selects-reservas");
        const data = await response.json();

        clientesCache = data.clientesEnvios || [];
        renderClientes();

        btnListaClientes.addEventListener('click', (event) => {
            event.preventDefault();
            listaClientesVisible = !listaClientesVisible;
            listaClientesSection.hidden = !listaClientesVisible;

            if (listaClientesVisible) {
                paginaActualClientes = 1;
                renderListaClientes();
                listaClientesSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });

        buscarClienteInput.addEventListener('input', () => {
            renderClientes(buscarClienteInput.value);
        });

        const cargarPaquetesCliente = async () => {
            const getCliente = clienteSelect.value;

            if (!getCliente) {
                document.getElementById("listaPaquetes").innerHTML = "";
                return;
            }

            const response = await fetch(`/api/paquetesMariana/vista-paquetes?cliente=${getCliente}`);
            const paquetes = await response.json();
            
            const listaPaquetes = document.getElementById("listaPaquetes");
            listaPaquetes.innerHTML = ""; // Limpiar lista anterior

            // Si no hay registros, mostrar mensaje de error
            if (paquetes.mensaje) {
                listaPaquetes.innerHTML = `<p style="color: red; text-align: center;">${paquetes.mensaje}</p>`;
                return;
            }

            const tabla = document.createElement("table");
            tabla.className = "sp-table";
            tabla.innerHTML = `
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Descripción</th>
                        <th>Número de sesiones</th>
                        <th>Monto Total</th>
                        <th>DETALLES</th>
                        <th>ACCIONES</th>
                    </tr>
                </thead>
                <tbody></tbody>
            `;

            const tbody = tabla.querySelector("tbody");

            listaPaquetes.appendChild(tabla);
            
            paquetes.forEach(paquete => {

                // Formatear fecha
                const fechaObjeto = new Date(paquete.fecha_compra + "T00:00:00");
                const opcionesFormato = { day: "2-digit", month: "2-digit", year: "numeric" };
                const fechaFormateada = fechaObjeto.toLocaleDateString("es-ES", opcionesFormato);

                // Crear opciones para el detalle
                const accederDetalle = document.createElement('a');
                accederDetalle.textContent = 'Ver detalle';
                accederDetalle.classList.add('boton-detalle');
                accederDetalle.href = `/paquetesMariana/detalles?paquete=${paquete.id}`; // Redirige a la nueva vista

                const eliminarPaquete = document.createElement('button');
                eliminarPaquete.textContent = 'Eliminar';
                eliminarPaquete.classList.add('boton-eliminar-paquete');
                eliminarPaquete.type = 'button';
                eliminarPaquete.dataset.id = paquete.id;

                // Crear elementos HTML
                const item = document.createElement("tr");
                item.innerHTML = `
                                    <td>${fechaFormateada}</td>
                                    <td>${paquete.descripcion}</td>
                                    <td>${paquete.numero_sesiones} SES.</td>
                                    <td>${paquete.monto_total} USD</td>
                                    <td>${accederDetalle.outerHTML}</td>
                                    <td>${eliminarPaquete.outerHTML}</td>
                                `;

                tbody.appendChild(item);
            });

            listaPaquetes.appendChild(tabla);

            document.querySelectorAll('.boton-eliminar-paquete').forEach((btn) => {
                btn.addEventListener('click', async () => {
                    const paqueteId = Number(btn.dataset.id);
                    const confirmar = window.confirm('Esta accion eliminara el paquete y sus sesiones. Deseas continuar?');

                    if (!confirmar) return;

                    const claveAdmin = window.prompt('Ingresa la clave admin para eliminar este paquete:');

                    if (!claveAdmin) {
                        alert('La clave admin es obligatoria.');
                        return;
                    }

                    try {
                        const deleteResponse = await fetch('/api/paquetesMariana/delete', {
                            method: 'DELETE',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id: paqueteId, claveAdmin })
                        });

                        const deleteData = await deleteResponse.json();

                        if (!deleteResponse.ok) {
                            alert(deleteData.error || 'No se pudo eliminar el paquete.');
                            return;
                        }

                        alert(deleteData.message || 'Paquete eliminado exitosamente.');
                        await cargarPaquetesCliente();
                    } catch (error) {
                        console.error('Error eliminando paquete:', error);
                        alert('Ocurrio un error eliminando el paquete.');
                    }
                });
            });
        };

        // Mostrar paquetes del cliente seleccionado
        clienteSelect.addEventListener("change", cargarPaquetesCliente);

    </script>

    <style>

        .box-texto{
            padding: .5rem;
            display: flex;
            justify-content: center;
            align-items: center;

            & p{
                text-align: justify;
                line-height: 1.5;
                margin-bottom: 1.5rem;
                font-size: .85rem;
            }
        }

        .box-buscador{
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        #buscar-cliente {
            width: 300px;
            margin-bottom: 0.75rem;
        }

        .botones-acciones {
            gap: 2rem;
            flex-wrap: wrap;
        }

        .lista-clientes-section {
            margin-top: 1.5rem;
        }

        .paginacion-clientes {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1rem;
            margin-top: 1rem;
        }

        .paginacion-info {
            font-size: 0.95rem;
            font-weight: 600;
            color: #4D4D4D;
        }

        .paginacion-btn {
            background: #DDB57F;
            color: #4D4D4D;
            border: none;
            height: 36px;
            width: auto;
            min-width: 100px;
            padding: 5px 14px;
            border-radius: 5px;
            cursor: pointer;
            box-shadow: 0 2px 2px #00000029;
            font-family: inherit;
            font-weight: 600;
        }

        .paginacion-btn:hover:not(:disabled) {
            opacity: 0.8;
        }

        .paginacion-btn:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

        .link-whatsapp {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #4D4D4D;
            font-weight: 700;
            text-decoration: none;
            border-bottom: 1px solid transparent;
            padding: 2px 4px;
            border-radius: 4px;
            transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
        }

        .link-whatsapp__icon {
            display: inline-flex;
            color: #DDB57F;
        }

        .link-whatsapp:hover {
            color: #DDB57F;
            border-color: #DDB57F;
        }

        .link-whatsapp:hover .link-whatsapp__icon {
            color: #4D4D4D;
        }

    </style>
</Layout>