---
import Layout from '../../layouts/Layout.astro';
---

<Layout>

    <main class="container-general">
        <h1>AGREGAR PORCENTAJE</h1>

        <form action="/agregar-servicios" id="formulario">
            <label for="porcentajeSpa">Porcentaje SPA</label>
            <input type="number" name="porcentajeSpa" id="porcentajeSpa" min="0" max="100" step="1" placeholder="Ej: 50" />

            <label for="porcentajeEmpleado">Porcentaje empleada</label>
            <input type="number" name="porcentajeEmpleado" id="porcentajeEmpleado" min="0" max="100" step="1" placeholder="Ej: 50" />

            <small id="detalleReparto" class="detalle-reparto"></small>
            <button type="submit" style="margin-top: 40px;">Agregar</button>
        </form>
    </main>

    <script type="module">

        const formulario = document.getElementById('formulario');
        const porcentajeSpaInput = document.getElementById('porcentajeSpa');
        const porcentajeEmpleadoInput = document.getElementById('porcentajeEmpleado');
        const detalleReparto = document.getElementById('detalleReparto');

        const actualizarDetalle = () => {
            const porcentajeSpa = Number(porcentajeSpaInput.value || 0);
            const porcentajeEmpleado = Number(porcentajeEmpleadoInput.value || 0);

            if (!porcentajeSpaInput.value && !porcentajeEmpleadoInput.value) {
                detalleReparto.textContent = '';
                return;
            }

            detalleReparto.textContent = `Se guardara SPA ${porcentajeSpa}% / EMPLEADA ${porcentajeEmpleado}%`;
        };

        porcentajeSpaInput.addEventListener('input', actualizarDetalle);
        porcentajeEmpleadoInput.addEventListener('input', actualizarDetalle);

        formulario.addEventListener('submit', (event) => {  

            event.preventDefault();

            const porcentajeSpa = Number(porcentajeSpaInput.value);
            const porcentajeEmpleado = Number(porcentajeEmpleadoInput.value);

            if (!Number.isFinite(porcentajeSpa) || !Number.isFinite(porcentajeEmpleado)) {
                alert('Ingresa ambos porcentajes para continuar.');
                return;
            }

            const totalPorcentajes = Number((porcentajeSpa + porcentajeEmpleado).toFixed(2));
            if (totalPorcentajes !== 100) {
                alert('El reparto seleccionado no suma 100%.');
                return;
            }

            const url = "/api/servicios";
            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ porcentajeSpa, porcentajeEmpleado }),
            })
            .then((response) => {
                if (!response.ok) {
                    throw new Error('Algo está mal con tu FETCH', response.status );
                } 
                return response.json();
            })
            .then((data) => {
                console.log(data);
                formulario.reset();
                detalleReparto.textContent = '';
                window.location.href = '/servicios';
            })
            .catch((error) => {
                console.error('Error agregando reparto:', error);
                alert(error.message || 'No se pudo guardar el reparto.');
            });
        });

    </script>

    <style>
        .detalle-reparto {
            display: block;
            width: min(100%, 360px);
            margin: 0.35rem auto 0;
            color: #4D4D4D;
            font-size: 0.8rem;
            text-align: left;
        }
    </style>

</Layout>