---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <main class="container-general">
        <h1>TASAS DE CAMBIO</h1>

        <form id="formularioTasa">
            <label for="tasaBs">Tasa BS (bolívares por 1 USD)</label>
            <input type="text" id="tasaBs" name="tasaBs" placeholder="Ej: 36.50" />
            <p id="detalleTasaBs" class="detalle-tasa"></p>

            <label for="tasaCop">Tasa COP (pesos por 1 USD)</label>
            <input type="text" id="tasaCop" name="tasaCop" placeholder="Ej: 4100" />
            <p id="detalleTasaCop" class="detalle-tasa"></p>

            <button type="submit">Guardar tasas</button>
        </form>
    </main>

    <script type="module">
        const formulario = document.getElementById("formularioTasa");
        const tasaBsInput = document.getElementById("tasaBs");
        const tasaCopInput = document.getElementById("tasaCop");
        const detalleTasaBs = document.getElementById("detalleTasaBs");
        const detalleTasaCop = document.getElementById("detalleTasaCop");

        const formatear = (valor) => Number(valor || 0).toFixed(2);

        const cargarTasas = async () => {
            try {
                const response = await fetch("/api/tasas");
                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || "No se pudieron cargar las tasas.");
                }

                const bs = Number(data.tasas?.bs ?? data.tasaBs ?? 0);
                const cop = Number(data.tasas?.cop ?? data.tasaCop ?? 0);

                tasaBsInput.value = bs > 0 ? formatear(bs) : "";
                tasaCopInput.value = cop > 0 ? formatear(cop) : "";

                detalleTasaBs.textContent = bs > 0
                    ? `Actual: ${formatear(bs)} BS por USD.`
                    : "No hay tasa BS configurada.";
                detalleTasaCop.textContent = cop > 0
                    ? `Actual: ${formatear(cop)} COP por USD.`
                    : "No hay tasa COP configurada.";
            } catch (error) {
                console.error("Error cargando tasas:", error);
                detalleTasaBs.textContent = "No se pudo cargar la tasa BS.";
                detalleTasaCop.textContent = "No se pudo cargar la tasa COP.";
                detalleTasaBs.style.color = "#C62828";
                detalleTasaCop.style.color = "#C62828";
            }
        };

        formulario.addEventListener("submit", async (event) => {
            event.preventDefault();

            const bs = tasaBsInput.value.trim();
            const cop = tasaCopInput.value.trim();

            if (!/^\d*\.?\d+$/.test(bs) || Number(bs) <= 0) {
                alert("La tasa BS debe ser un número mayor a cero.");
                return;
            }

            if (!/^\d*\.?\d+$/.test(cop) || Number(cop) <= 0) {
                alert("La tasa COP debe ser un número mayor a cero.");
                return;
            }

            try {
                const response = await fetch("/api/tasas", {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        bs: Number(bs),
                        cop: Number(cop),
                    }),
                });

                const data = await response.json();

                if (!response.ok) {
                    alert(data.error || "No se pudieron actualizar las tasas.");
                    return;
                }

                alert(data.message || "Tasas actualizadas exitosamente.");
                await cargarTasas();
            } catch (error) {
                console.error("Error guardando tasas:", error);
                alert("Ocurrió un error al guardar las tasas.");
            }
        });

        document.addEventListener("DOMContentLoaded", cargarTasas);
    </script>

    <style is:global>
        .detalle-tasa {
            margin: -0.35rem 0 0.35rem;
            font-size: 0.8rem;
            color: #7a7165;
            text-align: left;
        }
    </style>
</Layout>
