---
import Layout from '../../layouts/Layout.astro';
---

<Layout>

    <main class="container-general">
        <h1>AGREGAR SESIÓN / ABONO</h1>
        <form id="formulario">

            <label for="fecha">Fecha de la sesión</label>
            <input type="date" name="fecha" id="fecha" placeholder="Fecha de la sesión" required>
            <br />

            <label for="numero-sesion">Número de sesión</label>
            <input type="text" name="numero-sesion" id="numero-sesion" placeholder="Se asigna automáticamente" readonly>
            <br />

            <label class="checkbox-linea" for="abono-sin-sesion">
                <input type="checkbox" name="abono-sin-sesion" id="abono-sin-sesion">
                Registrar solo abono (sin consumir sesión)
            </label>
            <br />

            <label for="abono-pago">Abono de pago</label>
            <input type="text" name="abono-pago" id="abono-pago" placeholder="Abono pago" required>
            <br />

            <button type="submit" style="margin-top: 40px;">Agregar</button>
        </form>


    <script type="module">

        const url = new URL(window.location.href);
        const idPaquete = url.searchParams.get("paquete");

        const formulario = document.getElementById("formulario");
        const abonoSinSesionCheckbox = document.getElementById("abono-sin-sesion");
        const numeroSesionInputEl = document.getElementById("numero-sesion");
        let validacionActual = null;

        const cargarValidacion = async () => {
            const validacionResponse = await fetch(`/api/paquetesMariana/validar-sesiones?id=${idPaquete}`);
            const validacionData = await validacionResponse.json();

            if (!validacionResponse.ok) {
                throw new Error(validacionData.error || 'No se pudo validar el paquete.');
            }

            validacionActual = validacionData.validacionTotal || null;
            return validacionActual;
        };

        const refrescarNumeroSesion = () => {
            const esAbonoSinSesion = abonoSinSesionCheckbox.checked;

            if (esAbonoSinSesion) {
                numeroSesionInputEl.value = 'ABONO SIN SESION';
                return;
            }

            const proximaSesion = Number(validacionActual?.proximaSesion ?? 1);
            const sesionesTotales = Number(validacionActual?.sesionesTotales ?? 0);
            numeroSesionInputEl.value = `Sesion ${proximaSesion}${sesionesTotales > 0 ? ` de ${sesionesTotales}` : ''}`;
        };

        abonoSinSesionCheckbox.addEventListener('change', () => {
            refrescarNumeroSesion();
        });

        document.addEventListener('DOMContentLoaded', async () => {
            try {
                await cargarValidacion();
                refrescarNumeroSesion();
            } catch (error) {
                console.error('Error validando paquete:', error);
                alert('No se pudo cargar la información del paquete.');
            }
        });

        formulario.addEventListener("submit", async (event) => {

            event.preventDefault();

            const fecha = document.getElementById("fecha").value;
            const abonoPagoInput = document.getElementById("abono-pago").value.trim();
            const esAbonoSinSesion = abonoSinSesionCheckbox.checked;

            // Validar campos
            if (!fecha || abonoPagoInput === '') {
                alert('Por favor, rellena todos los campos.');
                return;
            }

            if (!/^\d+(\.\d{1,2})?$/.test(abonoPagoInput)) {
                alert('El abono debe ser un número válido mayor o igual a 0.');
                return;
            }

            const abonoPago = Number(abonoPagoInput);

            try {
                const validacion = await cargarValidacion();
                refrescarNumeroSesion();

                const saldoPendiente = Number(validacion?.monto ?? 0);
                const sesionesRestantes = Number(validacion?.sesiones ?? 0);

                if (!esAbonoSinSesion && sesionesRestantes <= 0) {
                    alert('No se pueden agregar más sesiones para este paquete.');
                    return;
                }

                if (abonoPago > saldoPendiente) {
                    alert(`El abono no puede ser mayor al saldo pendiente (${saldoPendiente} USD).`);
                    return;
                }

                const guardarResponse = await fetch('/api/paquetesMariana/agregar-sesiones', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ fecha, abonoPago, idPaquete, esAbonoSinSesion }),
                });

                const resultado = await guardarResponse.json();

                if (!guardarResponse.ok) {
                    alert(resultado.error || 'No se pudo agregar la sesión.');
                    return;
                }

                formulario.reset();
                window.location.href = `/paquetesMariana/detalles?paquete=${idPaquete}`;
            } catch (error) {
                console.error('Error agregando sesión:', error);
                alert('Ocurrió un error al guardar la sesión.');
            }
        });



    </script>

    <style>
        .checkbox-linea {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            width: 300px;
            margin: 0 auto;
            font-weight: 600;
            font-size: 0.85rem;
        }

        #numero-sesion {
            cursor: not-allowed;
            color: #6b6b6b;
        }
    </style>



</Layout>