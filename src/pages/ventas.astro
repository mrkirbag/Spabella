---
import Layout from '../layouts/Layout.astro';

    const fechaHoy = new Date();
    const ano = fechaHoy.getFullYear();
    const mes = String(fechaHoy.getMonth() + 1).padStart(2, '0');
    const dia = String(fechaHoy.getDate()).padStart(2, '0');
    let fechaCompleta = `${ano}-${mes}-${dia}`;
---

<Layout>
    <main class="container-general">
        <h1>LISTA DE VENTAS</h1>

        <div class="modulo-busqueda">
            <div class="campo-busqueda">
                <label for="fechaSeleccionada">Fecha</label>
                <input type="date" id="fechaSeleccionada" value={fechaCompleta} />
            </div>
            <button id="buscarVentas" type="button">Buscar Ventas</button>
        </div>

        <section id="resumenCaja" class="sp-panel" hidden></section>

        <section id="panelVentas" class="sp-panel" hidden>
            <div class="sp-panel-header">
                <div>
                    <p class="sp-eyebrow">Movimientos</p>
                    <h2>Ventas del día</h2>
                </div>
                <span id="contadorVentas" class="sp-chip"></span>
            </div>
            <table id="listaVentas" class="sp-table"></table>
        </section>

        <p id="mensajeVacio" class="sp-msg-empty sp-panel" hidden style="padding:1.1rem;"></p>

        <div class="container-boton_agregar">
            <a href="/ventas/agregar-ventas" class="boton-agregar">Agregar Venta</a>
        </div>
    </main>

    <script type="module">
        const formatearMonto = (monto) => Number(monto || 0).toFixed(2);

        const button = document.getElementById("buscarVentas");
        const resumenCaja = document.getElementById("resumenCaja");
        const panelVentas = document.getElementById("panelVentas");
        const mensajeVacio = document.getElementById("mensajeVacio");
        const contadorVentas = document.getElementById("contadorVentas");

        const colorMoneda = (moneda) => {
            if (moneda === "USD") return "sp-money-usd";
            if (moneda === "COP") return "sp-money-cop";
            return "sp-money-bs";
        };

        const renderPagos = (pagos = []) => {
            if (!pagos.length) return `<span style="color:#c0b6a8;font-weight:700;">—</span>`;
            return `
                <div class="sp-money">
                    ${pagos.map((pago) => `
                        <div class="sp-money-item ${colorMoneda(pago.moneda)}">
                            <strong>${formatearMonto(pago.monto)}</strong>
                            <span>${pago.moneda}</span>
                        </div>
                        <span class="sp-money-meta">${pago.metodo_pago || "Sin método"}</span>
                    `).join("")}
                </div>
            `;
        };

        const renderResumenCaja = (caja, tasas) => {
            if (!caja) {
                resumenCaja.hidden = true;
                resumenCaja.innerHTML = "";
                return;
            }

            const metodosRows = (caja.porMetodo || [])
                .map((item) => `
                    <tr>
                        <td><strong>${item.clave}</strong></td>
                        <td class="sp-num sp-usd">${item.usd > 0 ? formatearMonto(item.usd) : "—"}</td>
                        <td class="sp-num sp-cop">${item.cop > 0 ? formatearMonto(item.cop) : "—"}</td>
                        <td class="sp-num sp-bs">${item.bs > 0 ? formatearMonto(item.bs) : "—"}</td>
                    </tr>
                `)
                .join("");

            resumenCaja.hidden = false;
            resumenCaja.innerHTML = `
                <div class="sp-panel-header">
                    <div>
                        <p class="sp-eyebrow">Resumen de caja</p>
                        <h2>Totales del día</h2>
                    </div>
                    <span class="sp-chip">BS ${tasas.bs > 0 ? formatearMonto(tasas.bs) : "N/D"} · COP ${tasas.cop > 0 ? formatearMonto(tasas.cop) : "N/D"}</span>
                </div>
                <div class="sp-totales">
                    <div class="sp-total sp-total-usd">
                        <span>Entró en USD</span>
                        <strong>${formatearMonto(caja.totalUsd)}</strong>
                    </div>
                    <div class="sp-total sp-total-cop">
                        <span>Entró en COP</span>
                        <strong>${formatearMonto(caja.totalCop)}</strong>
                    </div>
                    <div class="sp-total sp-total-bs">
                        <span>Entró en BS</span>
                        <strong>${formatearMonto(caja.totalBs)}</strong>
                    </div>
                </div>
                <div class="sp-panel-body">
                    <h3 class="sp-subtitle">Por método de pago</h3>
                    <table class="sp-table">
                        <thead>
                            <tr>
                                <th>Método</th>
                                <th>USD</th>
                                <th>COP</th>
                                <th>BS</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${metodosRows || `<tr><td colspan="4" class="sp-empty">Sin pagos registrados.</td></tr>`}
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>Total</td>
                                <td class="sp-num sp-usd">${formatearMonto(caja.totalUsd)}</td>
                                <td class="sp-num sp-cop">${formatearMonto(caja.totalCop)}</td>
                                <td class="sp-num sp-bs">${formatearMonto(caja.totalBs)}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            `;
        };

        const cargarVentas = async () => {
            const fecha = document.getElementById("fechaSeleccionada").value;
            const response = await fetch(`/api/ventas/vista-ventas?fecha=${fecha}`);
            const data = await response.json();
            const ventas = data.ventas || [];
            const tasas = {
                bs: Number(data.tasas?.bs ?? data.tasaBs ?? 0),
                cop: Number(data.tasas?.cop ?? data.tasaCop ?? 0),
            };
            const tablaVentas = document.getElementById("listaVentas");
            tablaVentas.innerHTML = "";

            if (data.mensaje) {
                renderResumenCaja(null, tasas);
                panelVentas.hidden = true;
                mensajeVacio.hidden = false;
                mensajeVacio.textContent = data.mensaje;
                return;
            }

            mensajeVacio.hidden = true;
            panelVentas.hidden = false;
            contadorVentas.textContent = `${ventas.length} venta${ventas.length === 1 ? "" : "s"}`;
            renderResumenCaja(data.caja, tasas);

            tablaVentas.innerHTML = `
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Fecha</th>
                        <th>Descripción</th>
                        <th>Total</th>
                        <th>Pagos</th>
                        <th>Empleado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody></tbody>
            `;

            const tbody = tablaVentas.querySelector("tbody");

            ventas.forEach((venta, index) => {
                const fechaFormateada = new Date(venta.fecha + "T00:00:00").toLocaleDateString("es-ES", {
                    day: "2-digit",
                    month: "2-digit",
                    year: "numeric",
                });

                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td>${index + 1}</td>
                    <td>${fechaFormateada}</td>
                    <td class="sp-desc">
                        <strong>${venta.descripcion}</strong>
                        <small>SPA ${formatearMonto(venta.porcentaje_spabella)}% / Emp. ${formatearMonto(venta.porcentaje_empleado)}%</small>
                    </td>
                    <td class="sp-num">${formatearMonto(venta.monto)} USD</td>
                    <td>${renderPagos(venta.pagos || [])}</td>
                    <td>${venta.empleado}</td>
                    <td class="sp-actions">
                        <button type="button" class="boton-eliminar-venta" data-id="${venta.id}">Eliminar</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.querySelectorAll(".boton-eliminar-venta").forEach((btn) => {
                btn.addEventListener("click", async () => {
                    const ventaId = Number(btn.dataset.id);
                    if (!window.confirm("Esta accion eliminara la venta. Deseas continuar?")) return;
                    const claveAdmin = window.prompt("Ingresa la clave admin para eliminar esta venta:");
                    if (!claveAdmin) {
                        alert("La clave admin es obligatoria.");
                        return;
                    }

                    try {
                        const deleteResponse = await fetch("/api/ventas/delete", {
                            method: "DELETE",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ id: ventaId, claveAdmin }),
                        });
                        const deleteData = await deleteResponse.json();
                        if (!deleteResponse.ok) {
                            alert(deleteData.error || "No se pudo eliminar la venta.");
                            return;
                        }
                        alert(deleteData.message || "Venta eliminada exitosamente.");
                        await cargarVentas();
                    } catch (error) {
                        console.error("Error eliminando venta:", error);
                        alert("Ocurrio un error eliminando la venta.");
                    }
                });
            });
        };

        button.addEventListener("click", cargarVentas);
        document.addEventListener("DOMContentLoaded", cargarVentas);
    </script>

    <style is:global>
        .sp-total-cop {
            background: #f7f0e4;
            color: #8a5a12;
            border-left: 5px solid #c48a2e;
        }

        .sp-money-cop {
            background: #f7f0e4;
            color: #8a5a12;
        }

        .sp-cop {
            color: #8a5a12 !important;
        }
    </style>
</Layout>
